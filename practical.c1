#include <stdio.h>

// Call by Value
void callByValue(int a)
{
    a = a + 10;
    printf("Inside Call by Value: a = %d\n", a);
}

// Call by Reference using Pointers
void callByReference(int *p)
{
    *p = *p + 10;
    printf("Inside Call by Reference: a = %d\n", *p);
}

int main()
{
    int a = 10;
    int *ptr;

    ptr = &a;

    printf("Original value of a = %d\n", a);
    printf("Address of a = %p\n", (void *)&a);
    printf("Pointer ptr stores address = %p\n", (void *)ptr);

    callByValue(a);
    printf("After Call by Value: a = %d\n", a);

    callByReference(&a);
    printf("After Call by Reference: a = %d\n", a);

    return 0;
} 
output

Original value of a = 10
Address of a = 0x7ff... 
Pointer ptr stores address = 0x7ff...
Inside Call by Value: a = 20
After Call by Value: a = 10
Inside Call by Reference: a = 20
After Call by Reference: a = 20



